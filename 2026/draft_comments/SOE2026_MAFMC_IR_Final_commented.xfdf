><highlight color="#9643FC" opacity="0.399994" creationdate="D:20260302064736-05'00'" flags="print" IT="HighlightNote" date="D:20260302070304-05'00'" name="168824a6-38e8-4ec8-b48d-a033385f57ca" page="12" coords="538.153000,605.073000,555.312000,605.073000,538.153000,590.956000,555.312000,590.956000,56.693000,593.118000,555.304000,593.118000,56.693000,579.001000,555.304000,579.001000,56.693000,581.162000,393.909000,581.162000,56.693000,567.045000,393.909000,567.045000" rect="56.251800,566.604000,555.753000,605.514000" subject="Comment on Text" title="Kristan Blackhart"
