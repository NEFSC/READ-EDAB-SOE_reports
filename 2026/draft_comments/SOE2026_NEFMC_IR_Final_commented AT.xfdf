><highlight color="#9643FC" opacity="0.399994" creationdate="D:20260224124138-05'00'" flags="print" IT="HighlightNote" date="D:20260224124218-05'00'" name="595795ec-82b4-4923-8bf3-0c9613a29d61" page="46" coords="214.413000,544.840000,260.680000,544.840000,214.413000,530.723000,260.680000,530.723000" rect="213.972000,530.282000,261.121000,545.281000" subject="Comment on Text" title="Cameron Hodgdon"
><contents-richtext
><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:24.4.0" xfa:spec="2.0.2"
><p dir="ltr"
><span dir="ltr" style="font-size:10.5pt;text-align:left;font-weight:normal;font-style:normal"
>I would cite Fig 44 here again so readers know the Fig is not just for haddock.</span
></p
></body
></contents-richtext
><popup flags="print,nozoom,norotate" open="no" page="46" rect="588.653000,447.492000,772.580000,545.019000"
/></highlight
