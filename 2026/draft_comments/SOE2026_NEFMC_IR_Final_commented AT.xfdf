><highlight color="#9643FC" opacity="0.399994" creationdate="D:20260219144613-05'00'" flags="print" IT="HighlightNote" date="D:20260219144638-05'00'" name="e7cca74f-e8f6-4687-89c4-236cd2be93da" page="46" coords="84.714900,532.885000,109.127000,532.885000,84.714900,518.768000,109.127000,518.768000" rect="84.273700,518.327000,109.568000,533.326000" subject="Comment on Text" title="Cameron Hodgdon"
