>This is a partial sentence.</span
></p
></body
></contents-richtext
><popup flags="print,nozoom,norotate" open="no" page="2" rect="612.000000,516.632000,796.000000,608.632000"
/></highlight
><highlight color="#9643FC" opacity="0.399994" creationdate="D:20260225104957-05'00'" flags="print" IT="HighlightNote" date="D:20260225105005-05'00'" name="752a1a70-7902-43b6-8582-f53b18c876cc" page="2" coords="316.676000,542.632000,349.784000,542.632000,316.676000,531.975000,349.784000,531.975000" rect="316.343000,531.642000,350.117000,542.965000" subject="Comment on Text" title="Cameron Hodgdon"
