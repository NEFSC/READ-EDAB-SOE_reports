><highlight color="#9643FC" opacity="0.399994" creationdate="D:20260227083210-05'00'" flags="print" IT="HighlightNote" date="D:20260227083257-05'00'" name="3ade0730-e70b-4af6-94ec-6c5394512ad2" page="46" coords="100.518000,121.675000,266.708000,121.675000,100.518000,108.943000,266.708000,108.943000" rect="100.120000,108.545000,267.106000,122.073000" subject="Comment on Text" title="Kristan Blackhart"
><contents-richtext
